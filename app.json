{
  "expo": {
    "name": "tempered-strength-app",
    "slug": "tempered-strength-app",
    "version": "3.5.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "temperedstrengthapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kieranvenison.temperedstrengthapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kieranvenison.temperedstrengthapp",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android_icon.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.health.READ_RESTING_HEART_RATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/dark-splash-icon.png",
            "backgroundColor": "#0E0E10"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BarlowCondensed-SemiBold.ttf",
            "./assets/fonts/BarlowCondensed-Bold.ttf",
            "./assets/fonts/DSEG7Classic-Bold.ttf"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-video",
      "expo-web-browser",
      "expo-audio",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      "./plugins/withIosClockOrientations.js",
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "gym-rest-90",
              "title": "Rest 90s",
              "subtitle": "Between-set rest timer",
              "icon": "symbol:timer",
              "params": {
                "href": "/tools/timers?quick=rest90"
              }
            },
            {
              "id": "gym-tabata",
              "title": "Start Tabata",
              "subtitle": "8 × 20s / 10s",
              "icon": "symbol:flame",
              "params": {
                "href": "/tools/timers?quick=tabata"
              }
            }
          ]
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#0E0E10",
          "style": "light",
          "enforceContrast": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.kieranvenison.temperedstrengthapp.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.kieranvenison.temperedstrengthapp",
          "enablePushNotifications": false,
          "frequentUpdates": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Tempered Strength reads your resting heart rate and date of birth to calculate your heart rate training zones.",
          "NSHealthUpdateUsageDescription": "Tempered Strength does not write health data to Apple Health. This permission is required by HealthKit even for read-only access.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "753c3e7a-158d-41ec-b35c-772015ccbaa9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/753c3e7a-158d-41ec-b35c-772015ccbaa9"
    }
  }
}
