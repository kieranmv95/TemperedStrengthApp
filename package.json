{
  "name": "tempered-strength-app",
  "main": "expo-router/entry",
  "version": "3.2.1",
  "scripts": {
    "start": "expo start",
    "start-clean": "expo start -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios:production": "EXPO_NO_CAPABILITY_SYNC=1 eas build --platform ios --profile production",
    "build:android:production": "eas build --platform android --profile production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:contrast": "jest src/__tests__/contrast.test.ts src/utils/contrast.test.ts",
    "update:production": "eas update --channel production",
    "update:preview": "eas update --channel preview",
    "bump-version": "node ./scripts/bump-version.js"
  },
  "dependencies": {
    "@expo/ui": "~58.0.20",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@sanity/client": "^6.29.1",
    "@supabase/supabase-js": "^2.100.0",
    "expo": "~58.0.12",
    "expo-application": "~58.1.1",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.6",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.4",
    "expo-router": "~58.0.21",
    "expo-splash-screen": "~58.0.9",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "expo-video": "~58.0.11",
    "expo-web-browser": "~58.0.6",
    "expo-widgets": "~58.0.20",
    "posthog-react-native": "^4.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "^10.14.0",
    "react-native-purchases-ui": "^10.14.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.11",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "private": true
}
